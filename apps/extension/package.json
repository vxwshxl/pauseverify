{
  "name": "@pv/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Pause & Verify — a calm second opinion on suspicious messages, right where they appear.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pv/engine": "workspace:*",
    "@pv/island": "workspace:*",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
